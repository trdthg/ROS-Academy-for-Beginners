<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <gravity>0 0 -9.8</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.68 0.68 0.68 1.0</ambient>
      <background>0.9 0.9 0.95 1.0</background>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://ISCAS_groundplane</uri>
    </include>

    <model name="museum_floor_overlay">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 0.01 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://ISCAS_groundplane/meshes/ground_plane.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://ISCAS_Museum</uri>
      <pose>0 0 0 0 0 -1.57</pose>
    </include>
  </world>
</sdf>
